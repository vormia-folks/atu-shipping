{
    "name": "vormia-folks/atu-shipping",
    "description": "ATU Shipping - A package for Laravel that provides shipping support for your e-commerce website.",
    "keywords": ["laravel", "php", "a2commerce", "atu", "atu-shipping","vormia"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0",
        "vormiaphp/vormia": "^5.4",
        "a2-atu/a2commerce": "^0.2.0"
    },
    "suggest": {
        "vormia-folks/atu-multi-currency": "Optional currency conversion when using ATU Multi-Currency (^2.0)"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Vormia\\ATUShipping\\": "src/"
        },
        "exclude-from-classmap": [
            "src/stubs/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Vormia\\ATUShipping\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vormia\\ATUShipping\\ATUShippingServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
